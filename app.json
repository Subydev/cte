{
  "expo": {
    "name": "CTE Calc",
    "slug": "cte",
    "version": "1.1.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cteeschema",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verisurf.ctecalc",
      "buildNumber": "1.1.12"
    },
    "android": {
      "package": "com.verisurfsoftware.ctecalc",
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "2b1d9425-327a-4fad-82c2-02b638f87a36"
      }
    },
    "experiments": {
      "baseUrl": "/cte"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
