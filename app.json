        "NSMicrophoneUsageDescription": "NOT USED",
        "NSMotionUsageDescription": "NOT USED",
        "NSPhotoLibraryAddUsageDescription": "NOT USED",
        "NSPhotoLibraryUsageDescription": "NOT USED",
        "NSRemindersUsageDescription": "NOT USED"        
      }
    },
    "android": {
      "package": "com.verisurfsoftware.ctecalculator",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
